# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Configuration
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.v4pvm60.mongodb.net/ai_govern?retryWrites=true&w=majority&appName=Cluster0

# Authentication & Security
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000

# Google OAuth Credentials (Google Identity Services Web Client)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Bootstrap Administrator (Designated Google email to auto-provision as PLATFORM_ADMIN)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Audit Demonstration Controls (Must be false in production)
ENABLE_AUDIT_TAMPER_DEMO=false

# Runtime Telemetry & External AI Integration
SENTINEL_INGESTION_KEY=sentinel_runtime_secret_key_2026
MONITORING_SERVICE_URL=http://127.0.0.1:8001
EXTERNAL_AI_URL=http://127.0.0.1:8000
